# Default production endpoint. Override with --api-url or this variable for other environments.
ASKNEWS_API_URL=https://api.asknews.app/v1

# Non-interactive authentication for CI, scripts, and agents.
ASKNEWS_API_KEY=

# Public OAuth client registered for the CLI's device flow.
ASKNEWS_OAUTH_CLIENT_ID=asknews-cli
ASKNEWS_AUTH_URL=https://auth.asknews.app

# Optional global output default: human, json, jsonl, or yaml.
ASKNEWS_OUTPUT=human

# Show the AskNews logo banner on `asknews --help`. Disabled by default; enable with 1/true/on.
ASKNEWS_BANNER=0
# Banner sail variant when shown: light or dark (auto-detected from COLORFGBG when unset).
ASKNEWS_BANNER_THEME=

# Agent skill installation controls.
ASKNEWS_NO_AGENT_SKILLS=0
ASKNEWS_AGENT_HOME=
# During npm/pnpm dependency lifecycle scripts, use:
# npm_config_asknews_agent_home=/controlled/home
